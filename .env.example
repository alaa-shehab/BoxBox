# Copy to .env. Every value is optional unless noted; everything here is free.

APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO
LOG_JSON=false                   # true -> one JSON object per log line

# inprocess: UI calls core/ directly (Streamlit Cloud). api: UI calls FastAPI (Docker/local).
BACKEND_MODE=inprocess
API_BASE_URL=http://localhost:8000

# SQLite locally; Neon Postgres in deployment: postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///./data/pitwall.db

# LLMs: open-weight models on free tiers (no credit card). Keys: console.groq.com, cloud.cerebras.ai
LLM_PROVIDER=groq                # groq | cerebras | ollama | fake
LLM_FALLBACK_PROVIDERS=["cerebras"]
GROQ_API_KEY=
CEREBRAS_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=openai/gpt-oss-120b
EXPLAINER_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=qwen/qwen3.8-27b
BACKUP_MODEL=qwen/qwen3.8-27b
CEREBRAS_MODEL=gpt-oss-120b
OLLAMA_MODEL=qwen3:4b
LLM_REQUESTS_PER_MINUTE=25

# Local ONNX models via fastembed (no API, no torch)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_ENABLED=true              # false saves ~130 MB RAM at some retrieval precision
ONNX_THREADS=2

# Optional tracing (Langfuse Cloud Hobby is free). Leave blank to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
